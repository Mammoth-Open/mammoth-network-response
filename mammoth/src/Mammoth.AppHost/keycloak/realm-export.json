{
  "realm": "mammoth",
  "enabled": true,
  "clients": [
    {
      "clientId": "gateway",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "gateway-secret",
      "redirectUris": ["http://localhost:5000/*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "web-app",
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["*"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "coordinator" },
      { "name": "volunteer" }
    ]
  }
}
